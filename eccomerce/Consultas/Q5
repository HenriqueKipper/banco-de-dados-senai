SELECT 
    c.nome AS categoria,
    SUM(ip.quantidade * ip.preco_unitario) AS total_faturado
FROM categorias c
JOIN produtos p 
    ON c.id = p.categoria_id
JOIN itens_pedido ip 
    ON p.id = ip.produto_id
JOIN pedidos pe
    ON ip.pedido_id = pe.id
WHERE pe.status IN ('Pago', 'Enviado')
GROUP BY c.id, c.nome
ORDER BY total_faturado DESC;